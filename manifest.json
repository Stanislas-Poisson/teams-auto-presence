{
  "manifest_version": 3,
  "name": "Teams Auto Presence",
  "short_name": "Teams Auto Presence",
  "version": "1.0.0",
  "description": "Automatically switches your Teams presence status on a configurable schedule (work / lunch / outside hours).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://teams.microsoft.com/*", "https://teams.live.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://teams.microsoft.com/*", "https://teams.live.com/*"],
      "js": ["content-isolated.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://teams.microsoft.com/*", "https://teams.live.com/*"],
      "js": ["content-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
